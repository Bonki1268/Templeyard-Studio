# 複製成 .env 後填入自己的金鑰（.env 已被 .gitignore 排除，不會進版本控制）
# Claude：https://platform.claude.com 建立 API 金鑰（或改用 ant auth login，就不需要這一行）
ANTHROPIC_API_KEY=
# Higgsfield：https://console.higgsfield.ai 建立 API 金鑰（Key ID 與 Secret）
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# 選填：覆寫預設模型
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=high
# HIGGSFIELD_IMAGE_MODEL=xai/grok-imagine-image-2.0
# HIGGSFIELD_VIDEO_MODEL=bytedance/seedance-2.0/image-to-video
# VIDEO_GENERATION_HEIGHT=720   # 分鏡影片生成解析度（720 或 1080）
